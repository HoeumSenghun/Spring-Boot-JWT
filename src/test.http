@baseUrl = http://localhost:8080

# For the "valid token" case only: run Login below, copy "token" into @token (no quotes).
@token = PASTE_JWT_HERE

### Login — get a real JWT for the "valid token" case
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
  "username": "senghun",
  "password": "password123"
}

### GET /api/users/me — A: no Authorization header → expect 401 Unauthorized
GET {{baseUrl}}/api/users/me

### GET /api/users/me — B: wrong / garbage Bearer token → expect 401 Unauthorized
GET {{baseUrl}}/api/users/me
Authorization: Bearer not-a-valid-jwt

### GET /api/users/me — C: valid token → expect 200 and "Hello, you are authenticated!"
# Set @token at the top after Login, then run this request.
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
